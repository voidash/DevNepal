{
  "uid": "devnepal-database",
  "title": "DevNepal / Database & Maintenance",
  "description": "Query health, latency, and maintenance signals (pending migrations, N+1 risk).",
  "tags": ["devnepal", "nfr-obs-01", "database"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Queries per second, by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(db_queries_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Query error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rate(db_queries_total{outcome=\"error\"}[5m])) or vector(0)) / sum(rate(db_queries_total[5m]))",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Query latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queries per request (p95) — N+1 risk",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "description": "A rising trend here usually means a view grew an N+1 query pattern.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_queries_per_request_bucket[5m])) by (le))",
          "legendFormat": "p95 queries/request",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending Migrations",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "description": "Unapplied migrations on the running process's default database connection.",
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "db_pending_migrations", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Total Queries (5m)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(increase(db_queries_total[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Django Process Up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [{ "expr": "up{job=\"django\"}", "refId": "A" }]
    }
  ]
}
