{
  "uid": "devnepal-jobs-queues",
  "title": "DevNepal / Jobs & Maintenance",
  "tags": ["devnepal", "nfr-obs-01", "worker-monitoring", "maintenance"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Seconds since last successful run, by command",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 43200 },
              { "color": "red", "value": 86400 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "background_job_seconds_since_last_success",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Last run succeeded, by command",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAILED", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "background_job_last_run_success", "legendFormat": "{{command}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Job runs by status (1h rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(background_job_runs_total[1h])) by (command, status)",
          "legendFormat": "{{command}} · {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Job duration p95, by command",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(background_job_duration_seconds_bucket[1h])) by (le, command))",
          "legendFormat": "p95 {{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Operational queue depth",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "queue_depth", "legendFormat": "{{queue}}", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Pending Database Migrations",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "devnepal-prometheus" },
      "description": "A maintenance tool needs running if this is non-zero: uv run manage.py migrate.",
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "db_pending_migrations", "refId": "A" }]
    }
  ]
}
