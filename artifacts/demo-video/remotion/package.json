{
  "name": "devnepal-demo-video",
  "private": true,
  "scripts": {
    "record:brave": "node scripts/record-brave-flow.mjs",
    "record:refresh": "node scripts/record-live-refresh.mjs",
    "capture:long": "node scripts/capture-long-demo.mjs",
    "voice:kala": "node scripts/generate-voiceover.mjs",
    "voice:long": "node scripts/generate-long-voiceover.mjs",
    "render": "remotion render src/index.ts DevNepalNarrated ../DevNepal-GitHub-flow-demo.mp4",
    "render:long": "remotion render src/index.ts DevNepal20MinuteNepali ../DevNepal-20-minute-Nepali-demo.mp4 --codec=h264 --crf=23",
    "render:silent": "remotion render src/index.ts DevNepalSilent ../DevNepal-GitHub-flow-preview.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.521",
    "@remotion/media": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.521"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "playwright-core": "^1.55.0",
    "typescript": "5.9.2"
  }
}
