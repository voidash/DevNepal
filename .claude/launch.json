{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "devnepal",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec .venv/bin/python manage.py runserver 127.0.0.1:${PORT:-8000} --noreload"
      ],
      "env": { "DJANGO_SETTINGS_MODULE": "config.settings.dev" },
      "port": 8000,
      "autoPort": true
    }
  ]
}
